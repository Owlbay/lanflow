        "additionalProperties": false,
        "properties": {
          "payload": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "format": {
      "const": 1,
      "description": "File format version; this version writes and reads 1"
    },
    "overrides": {
      "description": "The override list, in the order the overrides apply",
