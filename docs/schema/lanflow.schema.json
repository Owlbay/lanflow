            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "pattern": "^https?://",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "type": [
        "array",
        "null"
      ]
    },
